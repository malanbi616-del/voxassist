<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/transcriptView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="18sp"
        android:text="Tap the mic and speak a command" />

    <Button
        android:id="@+id/micButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎤 Tap to Speak" />

    <EditText
        android:id="@+id/apiKeyField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Gemini API key (from Google AI Studio)" />

    <Button
        android:id="@+id/saveKeyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Key" />

</LinearLayout>
